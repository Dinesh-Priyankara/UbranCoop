# Server-side Cloudflare Pages environment variables. Nothing here goes in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Admin-created Supabase email identities are username@this-domain.
AUTH_EMAIL_DOMAIN=
# Private Google service account. Store these as Cloudflare server-side secrets.
GOOGLE_SHEET_ID=
GOOGLE_RECEIPTS_SHEET_ID=
GOOGLE_ACCOUNT_DAYS_SHEET_ID=
GOOGLE_ACCOUNT_TRANSACTIONS_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the PEM on one line with literal \\n characters when required by the host.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Local-only switch used by tests/preview-server.mjs. Never set in Cloudflare.
LIVE_SHEETS_TEST=0
