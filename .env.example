# Server-side Cloudflare Pages environment variables. Nothing here goes in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Admin-created Supabase email identities are username@this-domain.
AUTH_EMAIL_DOMAIN=
# Google Apps Script web-app /exec URL and a shared random 32+ character secret.
SHEETS_SCRIPT_URL=
SHEETS_SHARED_SECRET=
# Google Apps Script Script Properties (not Cloudflare/frontend):
# SPREADSHEET_ID=
# SHARED_SECRET= (same value as SHEETS_SHARED_SECRET)
